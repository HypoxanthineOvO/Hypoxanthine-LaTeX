\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{Hypo-Fonts}[2026/01/01 Hypoxanthine Fonts]

\RequirePackage{xeCJK}
\RequirePackage{fontspec}

% 英文设置
\IfFontExistsTF{DejaVu Serif}{\setmainfont{DejaVu Serif}}{\setmainfont{Latin Modern Roman}}
\IfFontExistsTF{DejaVu Sans}{\setsansfont{DejaVu Sans}}{\setsansfont{Latin Modern Sans}}
\IfFontExistsTF{DejaVu Sans Mono}{\setmonofont{DejaVu Sans Mono}}{\setmonofont{Latin Modern Mono}}

% ==============================================================================
% Font Selection Strategy
% ==============================================================================
\RequirePackage{expl3}
\RequirePackage{l3keys2e}
\ExplSyntaxOn

\tl_new:N \g_hypo_fonts_fontset_tl
\keys_define:nn { hypo / fonts }
  {
    fontset .tl_set:N = \g_hypo_fonts_fontset_tl,
    fontset .initial:n = tech, % Default to Tech
  }

\NewDocumentCommand{\HypoFontSetup}{m}
  {
    \keys_set:nn { hypo / fonts } {#1}
  }

\ProcessKeysOptions{ hypo / fonts }

% ------------------------------------------------------------------------------
% Strategy: Tech (Noto Sans CJK / Mono)
% ------------------------------------------------------------------------------
% Clean, modern sans-serif look for technical documentation.
\cs_new_protected:Npn \hypo_fonts_load_tech:
  {
    % CJK Main: Noto Sans CJK SC (Source Han Sans)
    \IfFontExistsTF{Noto~Sans~CJK~SC}
      {
        \setCJKmainfont[
            BoldFont       = Noto~Sans~CJK~SC~Bold,
            ItalicFont     = Noto~Sans~CJK~SC,
            ItalicFeatures = {FakeSlant=0.2},
            BoldItalicFont = Noto~Sans~CJK~SC~Bold,
            BoldItalicFeatures = {FakeSlant=0.2},
            RawFeature     = {+palt}
        ]{Noto~Sans~CJK~SC}
        \setCJKsansfont[BoldFont=Noto~Sans~CJK~SC~Bold]{Noto~Sans~CJK~SC}
      }
      {
        % Fallback: Fandol
        \typeout{Hypo-Fonts:~Noto~Sans~CJK~not~found,~checking~Fandol...}
        \IfFontExistsTF{FandolHei-Regular}
         {
            \setCJKmainfont[
                BoldFont       = FandolHei-Bold,
                ItalicFont     = FandolHei-Regular,
                ItalicFeatures = {FakeSlant=0.2}
            ]{FandolHei-Regular}
            \setCJKsansfont{FandolHei-Regular}
         }
         { \typeout{Hypo-Fonts:~Fandol~fonts~not~found~by~name.~Relying~on~ctex~default.} }
      }
      
    % CJK Mono: Noto Sans Mono CJK SC > FandolFang
    \IfFontExistsTF{Noto~Sans~Mono~CJK~SC}
      {
        \setCJKmonofont[
            BoldFont       = Noto~Sans~Mono~CJK~SC~Bold,
            ItalicFont     = Noto~Sans~Mono~CJK~SC,
            ItalicFeatures = {FakeSlant=0.2},
            BoldItalicFont = Noto~Sans~Mono~CJK~SC~Bold,
            BoldItalicFeatures = {FakeSlant=0.2}
        ]{Noto~Sans~Mono~CJK~SC}
      }
      {\IfFontExistsTF{FandolFang-Regular}{\setCJKmonofont{FandolFang-Regular}}{}}

    % Define \kaishu and \CJKfamily{kai} for consistency if needed, though tech mode uses Sans mostly.
    \IfFontExistsTF{LXGW~WenKai}
      {
        \setCJKfamilyfont{kai}{LXGW~WenKai}
        \ProvideDocumentCommand{\kaishu}{}{}
        \RenewDocumentCommand{\kaishu}{}{\CJKfamily{kai}}
      }
      {}
  }

% ------------------------------------------------------------------------------
% Strategy: Lit (LXGW WenKai / Serif)
% ------------------------------------------------------------------------------
% Humanist, serif/kai style for reading comfort.
\cs_new_protected:Npn \hypo_fonts_load_lit:
  {
    % 1. Serif Font Selection (Noto / Source Han)
    \IfFontExistsTF{Noto~Serif~CJK~SC}
      { \let\selected_serif_font\relax \def\selected_serif_font{Noto~Serif~CJK~SC} }
      {
        \IfFontExistsTF{Source~Han~Serif~SC}
          { \let\selected_serif_font\relax \def\selected_serif_font{Source~Han~Serif~SC} }
          { \let\selected_serif_font\relax }
      }

    % 2. Kaishu/Italic Font Selection (LXGW WenKai)
    \let\selected_kai_font\relax
    \IfFontExistsTF{LXGW~WenKai}
      { \def\selected_kai_font{LXGW~WenKai} }
      { \IfFontExistsTF{FandolKai-Regular} { \def\selected_kai_font{FandolKai-Regular} } {} }

    \ifx\selected_serif_font\relax
        % --- Fallback: Lit mode without Source Han ---
        \typeout{Hypo-Fonts:~Source~Han~Serif~not~found.~Using~Fallback.}
        \ifx\selected_kai_font\relax
           % Worst case: Use ctex default
        \else
           \setCJKmainfont[BoldFont=\selected_kai_font\space Bold, ItalicFont=\selected_kai_font]{\selected_kai_font}
           \setCJKsansfont{\selected_kai_font}
        \fi
    \else
        % --- Success: Source Han + LXGW ---
        \setCJKmainfont[
            BoldFont       = \selected_serif_font\space Bold,
            % Map Italic to Kaishu (LXGW) for Literature feel
            ItalicFont     = \ifx\selected_kai_font\relax \selected_serif_font \else \selected_kai_font \fi,
            ItalicFeatures = {\ifx\selected_kai_font\relax FakeSlant=0.2 \fi}
        ]{\selected_serif_font}
        
        % Sans -> Noto Sans CJK SC
        \IfFontExistsTF{Noto~Sans~CJK~SC}
          { \setCJKsansfont[BoldFont=Noto~Sans~CJK~SC~Bold]{Noto~Sans~CJK~SC} }
          { \setCJKsansfont{Source~Han~Sans~SC} }
          
        \typeout{Hypo-Fonts:~Using~\selected_serif_font\space~for~Literature.}
    \fi

    % 3. Explicitly Define Kaishu Family (Crucial for LitBox)
    \ifx\selected_kai_font\relax
    \else
      % Redefine \kaishu to use our selected Kai font (LXGW ideally)
      \setCJKfamilyfont{kai}[BoldFont=\selected_kai_font\space Bold]{\selected_kai_font}
      % Ensure standard command works
      \ProvideDocumentCommand{\kaishu}{}{}
      \RenewDocumentCommand{\kaishu}{}{\CJKfamily{kai}}
    \fi

    % Monofont
    \IfFontExistsTF{Noto~Sans~Mono~CJK~SC}
      {\setCJKmonofont{Noto~Sans~Mono~CJK~SC}}
      {\IfFontExistsTF{LXGW~WenKai~Mono}{\setCJKmonofont{LXGW~WenKai~Mono}}{}}
  }

% ------------------------------------------------------------------------------
% Apply Selection
% ------------------------------------------------------------------------------

\str_case:VnF \g_hypo_fonts_fontset_tl
  {
    {tech} { \hypo_fonts_load_tech: }
    {lit}  { \hypo_fonts_load_lit: }
  }
  {
    % Default or unknown -> Tech strategy
    \hypo_fonts_load_tech:
  }
  
\ExplSyntaxOff