% ==============================================================================
% 2. Semantic Logic & Scheme Switching
% ==============================================================================

\tl_new:N \g_hypo_colors_scheme_tl
\tl_new:N \g_hypo_colors_scheme_requested_tl

\keys_define:nn { hypo / colors }
	{
		scheme .tl_set:N = \g_hypo_colors_scheme_requested_tl,
		scheme .initial:n = Base,
	}

\cs_new_protected:Npn \hypo_colors_init_requested_scheme:
	{
		\tl_set:Nn \g_hypo_colors_scheme_requested_tl { Base }
		\cs_if_exist:NT \HypoColorScheme
			{
				\tl_set:Nx \g_hypo_colors_scheme_requested_tl
					{ \tl_trim_spaces:n { \HypoColorScheme } }
			}
	}

\cs_new_protected:Npn \hypo_colors_apply_requested_scheme:
	{
		\exp_args:NV \hypo_colors_apply_scheme:n \g_hypo_colors_scheme_requested_tl
	}

\NewDocumentCommand{\HypoColorSchemeSetup}{m}
	{
		\keys_set:nn { hypo / colors } {#1}
		\hypo_colors_apply_requested_scheme:
	}

\NewDocumentCommand{\HypoColorSchemeName}{}
	{ \tl_use:N \g_hypo_colors_scheme_tl }


% -----------------------------------------------------------------------------
% Scheme Definitions (Mapping Primitives to Semantics)
% -----------------------------------------------------------------------------

% --- Scheme: Base ---
\cs_new_protected:cpn { hypo_colors_scheme_Base: }
	{
		\colorlet{HypoText}{HypoGreyDark}
		\colorlet{HypoTextMuted}{HypoGrey}
		\colorlet{HypoBackground}{HypoBlueLight!8!white} % Subtle cool tint
		\colorlet{HypoSurface}{HypoBlueLight!20!white}   % Slightly deeper tint
		\colorlet{HypoBorder}{HypoGreyLight!80!HypoBlueLight}  % Tinted border
		\colorlet{HypoBorderStrong}{HypoBlue!40!HypoGrey}
		\colorlet{HypoTitleBackground}{HypoSurface}
		\colorlet{HypoTitleText}{HypoBlueDark}
		
		\colorlet{HypoPrimary}{HypoBlue}
		\colorlet{HypoSecondary}{HypoCyan}
		\colorlet{HypoAccent}{HypoPurple}
		\colorlet{HypoSuccess}{HypoGreen}
		\colorlet{HypoWarning}{HypoAmber}
		\colorlet{HypoDanger}{HypoRed}
	}

% --- Scheme: CN ---
