\cs_new_protected:Npn \hypo_colors_apply_scheme:n #1
	{
		\tl_set:Nx \l_tmpa_tl { \tl_trim_spaces:n {#1} }
		\tl_if_blank:VTF \l_tmpa_tl
			{ \tl_set:Nn \l_tmpa_tl { Base } }
			{ }

		% Normalize scheme name (case insensitive matching)
		\tl_set:Nx \l_tmpb_tl { \tl_upper_case:n { \l_tmpa_tl } }
		\tl_set:Nn \l_tmpc_tl { Base }
		
		\str_case:nnF { \l_tmpb_tl }
			{
				{BASE}{ \tl_set:Nn \l_tmpc_tl { Base } }
				{CN}{ \tl_set:Nn \l_tmpc_tl { CN } }
				{TECH}{ \tl_set:Nn \l_tmpc_tl { Tech } }
				{SIMPLE}{ \tl_set:Nn \l_tmpc_tl { Simple } }
			}
			{
				% Flexible alias matching (CN01 -> CN, etc.)
				\regex_match:nnTF { \A CN \d+ \Z } { \l_tmpb_tl }
					{ \tl_set:Nn \l_tmpc_tl { CN } }
					{
						\regex_match:nnTF { \A TECH \d+ \Z } { \l_tmpb_tl }
							{ \tl_set:Nn \l_tmpc_tl { Tech } }
							{
								\regex_match:nnTF { \A SIMPLE \d+ \Z } { \l_tmpb_tl }
									{ \tl_set:Nn \l_tmpc_tl { Simple } }
									{ \tl_set:Nn \l_tmpc_tl { Base } }
							}
					}
			}

		% Store canonical name
		\tl_set:NV \g_hypo_colors_scheme_tl \l_tmpc_tl

		% Dispatch scheme handler
		\cs_if_exist:cTF { hypo_colors_scheme_ \l_tmpc_tl : }
			{ \use:c { hypo_colors_scheme_ \l_tmpc_tl : } }
			{ \use:c { hypo_colors_scheme_Base: } }

		% -------------------------------------------------------------------------
		% Derived Colors (Calculated from Basic Semantics)
		% -------------------------------------------------------------------------
		
		% SurfaceAlt: A subtle variation of surface for nested UI
		\colorlet{HypoSurfaceAlt}{HypoSurface!88!HypoTextMuted}
		
		% Soft Tints: Used for box backgrounds, derived from accent colors
		% Mixed with 90% Surface to ensure readability and harmony
		\colorlet{HypoPrimarySoft}{HypoPrimary!10!HypoSurface}
		\colorlet{HypoSuccessSoft}{HypoSuccess!10!HypoSurface}
		\colorlet{HypoWarningSoft}{HypoWarning!10!HypoSurface}
		\colorlet{HypoDangerSoft}{HypoDanger!10!HypoSurface}

		% Public "HypoNote*" aliases for consistent external API
		\colorlet{HypoNoteText}{HypoText}
		\colorlet{HypoNoteBackground}{HypoBackground}
		\colorlet{HypoNoteBorder}{HypoBorder}
		\colorlet{HypoNotePrimary}{HypoPrimary}
		\colorlet{HypoNoteAccent}{HypoAccent}
	}

\hypo_colors_init_requested_scheme:
\hypo_colors_apply_requested_scheme:

\ExplSyntaxOff

