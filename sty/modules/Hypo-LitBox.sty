\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{Hypo-LitBox}[2026/01/30 v1.4.0 Hypoxanthine Literature Boxes]

\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage[most]{tcolorbox}
\RequirePackage{Hypo-Colors}

\tcbuselibrary{breakable,skins}

% NOTE: tcolorbox key values are parsed under normal LaTeX2e catcodes.
% Avoid expl3-style macro names (with '_' / ':') in key values.
\providecommand{\HypoLitBoxPoemFont}{\itshape}
\providecommand{\HypoLitBoxQuoteFont}{\itshape}
\makeatletter
\@ifundefined{kaishu}{}{%
  \renewcommand{\HypoLitBoxPoemFont}{\kaishu}%
  \renewcommand{\HypoLitBoxQuoteFont}{\kaishu}%
}
\makeatother

\NewDocumentCommand{\InlineQuote}{m}
  {{\begingroup
    \setlength\fboxsep{0.25em}%
    \colorbox{HypoSurfaceAlt}{\textcolor{HypoText}{\strut\,#1\,}}%
  \endgroup}}

% -----------------------------------------------------------------------------
% Base styles
% -----------------------------------------------------------------------------
\tcbset{
  hypo lit box/.style={
    enhanced,
    breakable,
    boxrule=0.4pt,
    colframe=HypoBorderStrong,
    colback=HypoSurface,
    coltext=HypoText,
    % Title bar: always light bg + dark ink, but still scheme-aware.
    coltitle=HypoTitleText,
    colbacktitle=HypoTitleBackground,
    left=1.0mm, right=1.0mm, top=0.8mm, bottom=0.8mm,
    arc=1mm,
    fonttitle=\bfseries,
    before skip=6pt,
    after skip=6pt,
    separator sign={:},
  },
}

\tcbset{
  hypo lit poem/.style={
    hypo lit box,
    % Poem: Very subtle tint (Background), soft border
    colframe=HypoBorder!60!HypoSurface,
    colback=HypoBackground!50!HypoSurface, % Blend for a soft paper-like feel
    fontupper=\HypoLitBoxPoemFont,
    halign=center
  },
  hypo lit quotepara/.style={
    hypo lit box,
    % Quote: Stronger contrast, distinct surface
    colframe=HypoBorderStrong,
    colback=HypoSurfaceAlt,
    fonttitle=\bfseries\itshape,
    fontupper=\HypoLitBoxQuoteFont,
  },
}

% -----------------------------------------------------------------------------
% Environments
% -----------------------------------------------------------------------------
% Use tcolorbox native keys (title=..., colback=..., etc.).
\NewTColorBox{poem}{ O{} }{hypo lit poem, #1}
\NewTColorBox{quotepara}{ O{} }{hypo lit quotepara, #1}

\endinput
