\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{Hypo-Algorithm}[2026/01/31 v1.4.1 Hypoxanthine Algorithms]

% Wrapper around algorithm2e with project defaults.
\RequirePackage{algorithm2e}

% A conservative default style (users can override in their preamble).
% - ruled/vlined: common readable layout
% - linesnumbered: helpful for references
\RestyleAlgo{ruled}
\LinesNumbered
\SetAlgoVlined

% If cleveref is loaded (via Hypo-Refs), make \cref output "Algorithm: <num>".
\makeatletter
\@ifpackageloaded{cleveref}{%
  \crefname{algocf}{Algorithm:}{Algorithms:}%
  \Crefname{algocf}{Algorithm:}{Algorithms:}%
}{}
\makeatother

\endinput
