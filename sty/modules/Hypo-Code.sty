\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{Hypo-Code}[2026/01/30 v1.4.0 Hypoxanthine Code]

\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage{fancyvrb} % for \VerbatimEnvironment
\RequirePackage{shellesc}

% If loaded via entry packages, \FinalOutputDir comes from Hypo-Base.
\makeatletter
\@ifundefined{FinalOutputDir}{\def\FinalOutputDir{build}}{}
\makeatother

\ExplSyntaxOn

\bool_new:N \g_hypo_code_warned_bool
\bool_new:N \l_hypo_code_use_minted_bool

\bool_new:N \l_hypo_code_linenos_bool
\tl_new:N   \l_hypo_code_theme_tl
\tl_new:N   \l_hypo_code_minted_extra_tl
\tl_new:N   \l_hypo_code_listings_extra_tl

\keys_define:nn { hypo / code }
    {
        linenos  .bool_set:N = \l_hypo_code_linenos_bool,
        linenos  .initial:n  = true,
        theme    .tl_set:N   = \l_hypo_code_theme_tl,
        theme    .initial:n  = ,
        minted   .tl_set:N   = \l_hypo_code_minted_extra_tl,
        minted   .initial:n  = ,
        listings .tl_set:N   = \l_hypo_code_listings_extra_tl,
        listings .initial:n  = ,
    }

\cs_new_protected:Npn \hypo_code_options_set:n #1
    { \keys_set:nn { hypo / code } {#1} }

\prg_new_conditional:Npnn \hypo_code_shell_escape_enabled: { p, T, F, TF }
    {
        \int_compare:nNnTF { \ShellEscapeStatus } = { 1 }
            { \prg_return_true: }
            { \prg_return_false: }
    }

\cs_new_protected:Npn \hypo_code_warn_fallback_once:
    {
        \bool_if:NF \g_hypo_code_warned_bool
            {
                \bool_set_true:N \g_hypo_code_warned_bool
                \PackageWarning{Hypo-Code}
                    {minted unavailable or shell-escape disabled; falling back to listings}
            }
    }

% Decide whether to use minted.
\bool_set_false:N \l_hypo_code_use_minted_bool
\file_if_exist:nTF { minted.sty }
    {
        \hypo_code_shell_escape_enabled:T
            {\bool_set_true:N \l_hypo_code_use_minted_bool}
    }
    { }

% ==============================================================================
% 1) minted path (preferred)
% ==============================================================================
\bool_if:NTF \l_hypo_code_use_minted_bool
    {
        \RequirePackage[outputdir=\FinalOutputDir]{minted}
        \setminted{
                frame=lines,
                framesep=2mm,
                baselinestretch=1.1,
                fontsize=\small,
                breaklines
        }

        % Re-implementation: DO NOT use +v argument.
        % Instead, use \VerbatimEnvironment and manually construct the minted environment.
        % This is much safer for Beamer and other fragile contexts.
        \tl_new:N \g_hypo_code_minted_opts_tl
        
        \NewDocumentEnvironment{hypocode}{ O{} m }
            {
                \hypo_code_options_set:n {#1}
                \VerbatimEnvironment % Magic for fancyvrb/minted to find the end
                
                % Build options list using clist to avoid leading/trailing commas
                \clist_clear:N \l_tmpa_clist
                \bool_if:NT \l_hypo_code_linenos_bool
                    { \clist_put_right:Nn \l_tmpa_clist { linenos } }
                
                \tl_if_blank:VF \l_hypo_code_theme_tl
                    { \clist_put_right:Nx \l_tmpa_clist { style=\l_hypo_code_theme_tl } }
                
                \tl_if_blank:VF \l_hypo_code_minted_extra_tl
                    { \clist_put_right:Nn \l_tmpa_clist { \l_hypo_code_minted_extra_tl } }

                % Pre-expand options to global tl
                \tl_gset:Nx \g_hypo_code_minted_opts_tl { \clist_use:Nn \l_tmpa_clist {,} }
                
                % Start minted: if options empty, omit [] entirely
                \tl_if_blank:VTF \g_hypo_code_minted_opts_tl
                    { \begin{minted}{#2} }
                    { \begin{minted}[\g_hypo_code_minted_opts_tl]{#2} }
            }
            {
                \end{minted}
            }
    }
% ==============================================================================
% 2) listings fallback
% ==============================================================================
    {
        \RequirePackage{listings}
        \RequirePackage{xcolor}

        \lstdefinestyle{hypo-code}{
            basicstyle=\ttfamily\small,
            frame=lines,
            numberstyle=\tiny,
            breaklines=true,
            columns=fullflexible,
            showstringspaces=false,
            tabsize=4
        }

        \cs_new:Npn \hypo_code_listings_lang:n #1
            {
                \str_case:nnF { \str_lowercase:n {#1} }
                    {
                        {python}{Python}
                        {py}{Python}
                        {cpp}{C++}
                        {c++}{C++}
                        {latex}{[LaTeX]TeX}
                        {tex}{[LaTeX]TeX}
                        {bash}{bash}
                        {sh}{bash}
                    }
                    {#1}
            }

        % Keep lstnewenvironment for listings support.
        % It handles verbatim body reading correctly.
        \lstnewenvironment{hypocode}[2][]
            {
                \hypo_code_warn_fallback_once:
                \hypo_code_options_set:n {#1}
                % Calculate options
                 \bool_if:NTF \l_hypo_code_linenos_bool
                    {
                         \tl_set:Nn \l_tmpa_tl { style=hypo-code, numbers=left, language=\hypo_code_listings_lang:n{#2} }
                    }
                    {
                         \tl_set:Nn \l_tmpa_tl { style=hypo-code, numbers=none, language=\hypo_code_listings_lang:n{#2} }
                    }
                
                \tl_if_blank:VF \l_hypo_code_listings_extra_tl
                    { \tl_put_right:Nn \l_tmpa_tl { , \l_hypo_code_listings_extra_tl } }
                
                \exp_args:NV \lstset \l_tmpa_tl
            }
            {}
    }

\ExplSyntaxOff

\endinput