% -----------------------------------------------------------------------------
% Configuration: Python Binary Path
% -----------------------------------------------------------------------------
% 定义一个全局变量存储 Python 路径，默认值为 python3
\tl_new:N \g_hypo_plot_python_bin_tl
\cs_if_exist:NTF \HypoPythonBin
  { \tl_gset:Nn \g_hypo_plot_python_bin_tl { \HypoPythonBin } }
  { \tl_gset:Nn \g_hypo_plot_python_bin_tl { python3 } }

% 提供接口让用户修改路径
\NewDocumentCommand \HypoSetPythonBin { m }
  {
    \tl_gset:Nn \g_hypo_plot_python_bin_tl { #1 }
  }

% -----------------------------------------------------------------------------
% Paths
% -----------------------------------------------------------------------------
\tl_new:N \g_hypo_plot_fig_dir_tl
\tl_new:N \g_hypo_plot_script_dir_tl
\tl_gset:Nn \g_hypo_plot_fig_dir_tl    {\FinalOutputDir/figures}
\tl_gset:Nn \g_hypo_plot_script_dir_tl {\FinalOutputDir/scripts}

\NewDocumentCommand \HypoPlotFigDir {} { \tl_use:N \g_hypo_plot_fig_dir_tl }
\NewDocumentCommand \HypoPlotScriptDir {} { \tl_use:N \g_hypo_plot_script_dir_tl }

% -----------------------------------------------------------------------------
% Shell-escape helpers
% -----------------------------------------------------------------------------
\bool_new:N \g_hypo_plot_shell_escape_bool
\bool_gset_false:N \g_hypo_plot_shell_escape_bool

\cs_new_protected:Npn \hypo_plot_detect_shell_escape:
  {
    \int_compare:nNnTF { \ShellEscapeStatus } = { 1 }
      { \bool_gset_true:N \g_hypo_plot_shell_escape_bool }
      { \bool_gset_false:N \g_hypo_plot_shell_escape_bool }
  }

\cs_new_protected:Npn \hypo_plot_shell_now:n #1
  {
    \bool_if:NTF \g_hypo_plot_shell_escape_bool
      {
        \group_begin:
          \edef\hypo@plot@cmd{#1}
          \immediate\write18{\hypo@plot@cmd}
        \group_end:
      }
      {
        \PackageWarningNoLine{Hypo-Plot}{shell-escape disabled; cannot run:~#1}
      }
  }

\cs_new_protected:Npn \hypo_plot_ensure_dirs:
  {
    \bool_if:NTF \g_hypo_plot_shell_escape_bool
      {
        \immediate\write18{mkdir\space -p\space "\tl_use:N \g_hypo_plot_fig_dir_tl"}
        \immediate\write18{mkdir\space -p\space "\tl_use:N \g_hypo_plot_script_dir_tl"}
      }
      {
        \PackageWarningNoLine{Hypo-Plot}{shell-escape disabled; cannot create output dirs}
      }
  }

\AtBeginDocument{%
  \hypo_plot_detect_shell_escape:%
  \hypo_plot_ensure_dirs:%
}

% -----------------------------------------------------------------------------
% Color sync logic
% -----------------------------------------------------------------------------
\cs_new:Npn \hypo_plot_hex_tmp: {}
\cs_new:Npn \hypo_plot_spec_tmp: {}

\cs_new_protected:Npn \hypo_plot_hex_set:Nn #1#2
  {
    \group_begin:
      \extractcolorspec{#2}{\hypo_plot_spec_tmp:}
      \expandafter\convertcolorspec\hypo_plot_spec_tmp:{HTML}\hypo_plot_hex_tmp:
      % NOTE: This is used to populate module-level variables that are later
      % written out to external files (Python/TikZ). The assignment must
      % survive this group.
      \tl_gset:Nx #1 { \hypo_plot_hex_tmp: }
    \group_end:
  }

\cs_new:Npn \hypo_plot_get_hex_to:Nn #1#2
  { \hypo_plot_hex_set:Nn #1 {#2} }

\NewDocumentCommand \HypoGetHex { m }
  {
    \group_begin:
      \hypo_plot_hex_set:Nn \l_tmpa_tl {#1}
      \tl_use:N \l_tmpa_tl
    \group_end:
  }

\tl_new:N \l_hypo_plot_hex_blue_tl
\tl_new:N \l_hypo_plot_hex_red_tl
\tl_new:N \l_hypo_plot_hex_green_tl
\tl_new:N \l_hypo_plot_hex_orange_tl
\tl_new:N \l_hypo_plot_hex_purple_tl

\cs_new_protected:Npn \hypo_plot_collect_theme_fingerprint:N #1
  {
    \hypo_plot_hex_set:Nn \l_hypo_plot_hex_blue_tl   {HypoBlue}
    \hypo_plot_hex_set:Nn \l_hypo_plot_hex_red_tl    {HypoRed}
    \hypo_plot_hex_set:Nn \l_hypo_plot_hex_green_tl  {HypoGreen}
    \hypo_plot_hex_set:Nn \l_hypo_plot_hex_orange_tl {HypoOrange}
    \hypo_plot_hex_set:Nn \l_hypo_plot_hex_purple_tl {HypoPurple}
    \tl_set:Nx #1
      {
        scheme=\HypoColorSchemeName;
        HypoBlue=\tl_use:N \l_hypo_plot_hex_blue_tl;
        HypoRed=\tl_use:N \l_hypo_plot_hex_red_tl;
        HypoGreen=\tl_use:N \l_hypo_plot_hex_green_tl;
        HypoOrange=\tl_use:N \l_hypo_plot_hex_orange_tl;
        HypoPurple=\tl_use:N \l_hypo_plot_hex_purple_tl;
      }
  }

% -----------------------------------------------------------------------------
% Caching wrapper
% -----------------------------------------------------------------------------
\cs_new_protected:Npn \hypo_plot_process_if_needed:nnn #1#2#3
  {
    \tcbiffileprocess{1}{#1}{#1.md5}{#2}
      {#3}
      { }
  }

% -----------------------------------------------------------------------------
% Graphics Inclusion Helpers (Refactored for readability)
% -----------------------------------------------------------------------------

% Helper: Check if options should be skipped (blank or 'undefined')
\prg_new_conditional:Npnn \hypo_plot_opts_empty:N #1 { TF, T, F }
  {
    \tl_if_blank:VTF #1
      { \prg_return_true: }
      {
        \tl_if_eq:VnTF #1 {undefined}
          { \prg_return_true: }
          { \prg_return_false: }
      }
  }

% Helper: Render file-not-found error box
\cs_new_protected:Npn \hypo_plot_render_error_box:N #1
  {
    \fbox{
      \begin{tabular}{l}
        \ttfamily\bfseries Hypo-Plot~Error \\
        \ttfamily Missing:~\tl_to_str:V #1 \\
        \ttfamily Check~build/scripts/~logs
      \end{tabular}
    }
  }

% Helper: Include graphics with centering wrapper
\cs_new_protected:Npn \hypo_plot_include_centered:nn #1#2
  {
    \par\noindent\hfil #1 \hfil\par
  }

% Main function: Include graphics with options
\cs_new_protected:Npn \hypo_plot_include_graphics:nn #1#2
  {
    \group_begin:
      \tl_set:Nn \l_tmpa_tl {#1}
      \tl_set:Nx \l_tmpb_tl {#2}
      \file_if_exist:VTF \l_tmpb_tl
        { \hypo_plot_include_existing:NN \l_tmpa_tl \l_tmpb_tl }
        { \hypo_plot_include_missing:N \l_tmpb_tl }
    \group_end:
  }

% Helper: Include existing file
\cs_new_protected:Npn \hypo_plot_include_existing:NN #1#2
  {
    \hypo_plot_opts_empty:NTF #1
      { \hypo_plot_include_bare:N #2 }
      { \hypo_plot_include_with_opts:NN #1 #2 }
  }

% Helper: Include without options
\cs_new_protected:Npn \hypo_plot_include_bare:N #1
  {
    \bool_if:NTF \l_hypo_plot_centering_bool
      { \hypo_plot_include_centered:nn { \includegraphics{\tl_use:N #1} } {} }
      { \includegraphics{\tl_use:N #1} }
  }

% Helper: Include with options
\cs_new_protected:Npn \hypo_plot_include_with_opts:NN #1#2
  {
    \bool_if:NTF \l_hypo_plot_centering_bool
      {
        \par\noindent\hfil
        \use:x { \exp_not:N \includegraphics [ \tl_use:N #1 ] { \tl_use:N #2 } }
        \hfil\par
      }
      {
        \use:x { \exp_not:N \includegraphics [ \tl_use:N #1 ] { \tl_use:N #2 } }
      }
  }

% Helper: Handle missing file
\cs_new_protected:Npn \hypo_plot_include_missing:N #1
  {
    \bool_if:NTF \l_hypo_plot_centering_bool
      { \hypo_plot_include_centered:nn { \hypo_plot_render_error_box:N #1 } {} }
      { \hypo_plot_render_error_box:N #1 }
  }

% -----------------------------------------------------------------------------
% HypoPyPlot
% -----------------------------------------------------------------------------
\tl_new:N \l_hypo_plot_width_tl
\tl_new:N \l_hypo_plot_height_tl
\bool_new:N \l_hypo_plot_centering_bool
\bool_set_true:N \l_hypo_plot_centering_bool
\int_new:N \l_hypo_plot_dpi_int
\fp_new:N  \l_hypo_plot_figwidth_fp
\fp_new:N  \l_hypo_plot_figheight_fp
\tl_new:N  \l_hypo_plot_format_tl
\tl_set:Nn \l_hypo_plot_format_tl {pdf}  % Set default value
\tl_new:N  \g_hypo_plot_name_tl  % Must declare before use in keys

\keys_define:nn { hypo / plot / pyplot }
  {
    name      .tl_gset:N = \g_hypo_plot_name_tl,
    name      .value_required:n = true,
    width     .tl_set:N = \l_hypo_plot_width_tl,
    width     .initial:n = ,
    height    .tl_set:N = \l_hypo_plot_height_tl,
    height    .initial:n = ,
    centering .bool_set:N = \l_hypo_plot_centering_bool,
    centering .initial:n = true,
    dpi       .int_set:N = \l_hypo_plot_dpi_int,
    dpi       .initial:n = 150,
    figwidth  .fp_set:N  = \l_hypo_plot_figwidth_fp,
    figwidth  .initial:n = 6,
    figheight .fp_set:N  = \l_hypo_plot_figheight_fp,
    figheight .initial:n = 4,
    format .choice:,
    format / pdf .code:n = { \tl_set:Nn \l_hypo_plot_format_tl {pdf} },
    format / png .code:n = { \tl_set:Nn \l_hypo_plot_format_tl {png} },
  }

\iow_new:N \l_hypo_plot_iow
\tl_new:N  \g_hypo_plot_script_path_tl
\tl_new:N  \g_hypo_plot_output_path_tl
\tl_new:N  \g_hypo_plot_script_tex_path_tl
\tl_new:N  \g_hypo_plot_output_tex_path_tl
\tl_new:N  \g_hypo_plot_script_tmp_tex_tl
\tl_new:N  \g_hypo_plot_output_shell_path_tl
\tl_new:N  \g_hypo_plot_include_opts_tl
\tl_new:N  \g_hypo_plot_theme_fp_tl
\tl_new:N  \g_hypo_plot_script_tmp_tl
\tl_new:N  \g_hypo_plot_figwidth_dec_tl
\tl_new:N  \g_hypo_plot_figheight_dec_tl

\cs_new_protected:Npn \hypo_plot_set_include_opts:
  {
    \tl_gclear:N \g_hypo_plot_include_opts_tl
    \tl_if_blank:VTF \l_hypo_plot_width_tl
      { }
      { 
        % Pre-compute width to resolve \linewidth and other dynamic lengths
        \dim_set:Nn \l_tmpa_dim { \l_hypo_plot_width_tl }
        \tl_gput_right:Nx \g_hypo_plot_include_opts_tl { width=\dim_use:N \l_tmpa_dim }
      }
    \tl_if_blank:VTF \l_hypo_plot_height_tl
      { }
      {
        \tl_if_blank:VTF \g_hypo_plot_include_opts_tl
          { 
            \dim_set:Nn \l_tmpa_dim { \l_hypo_plot_height_tl }
            \tl_gput_right:Nx \g_hypo_plot_include_opts_tl { height=\dim_use:N \l_tmpa_dim }
          }
          { 
            \dim_set:Nn \l_tmpa_dim { \l_hypo_plot_height_tl }
            \tl_gput_right:Nx \g_hypo_plot_include_opts_tl { ,height=\dim_use:N \l_tmpa_dim }
          }
      }
  }

\cs_new_protected:Npn \hypo_plot_pyplot_setup:n #1
  {
    % Reset per-call defaults (avoid state leaking across environments)
    \bool_set_true:N \l_hypo_plot_centering_bool
    \keys_set:nn { hypo / plot / pyplot } {#1}
    % Check if name is set
    \tl_if_empty:NT \g_hypo_plot_name_tl
      { \PackageError{Hypo-Plot}{Missing~'name'~option}{You~must~provide~name=filename~in~HypoPyPlot~options} }
    \hypo_plot_set_include_opts:

    \tl_gset:Nx \g_hypo_plot_script_tex_path_tl { scripts/\g_hypo_plot_name_tl.py }
    \tl_gset:Nx \g_hypo_plot_script_tmp_tex_tl { scripts/\g_hypo_plot_name_tl.tmp.py }
    % For \includegraphics, use a filesystem-visible path (TeX input search does
    % not reliably include -output-directory).
    \tl_gset:Nx \g_hypo_plot_output_tex_path_tl
      { \tl_use:N \g_hypo_plot_fig_dir_tl/\g_hypo_plot_name_tl.\l_hypo_plot_format_tl }

    \tl_gset:Nx \g_hypo_plot_script_path_tl { \tl_use:N \g_hypo_plot_script_dir_tl/\g_hypo_plot_name_tl.py }
    \tl_gset:Nx \g_hypo_plot_script_tmp_tl { \tl_use:N \g_hypo_plot_script_dir_tl/\g_hypo_plot_name_tl.tmp.py }
    \tl_gset_eq:NN \g_hypo_plot_output_path_tl \g_hypo_plot_output_tex_path_tl
    \tl_gset_eq:NN \g_hypo_plot_output_shell_path_tl \g_hypo_plot_output_tex_path_tl

    \hypo_plot_collect_theme_fingerprint:N \g_hypo_plot_theme_fp_tl
    \tl_gset:Nx \g_hypo_plot_figwidth_dec_tl  { \fp_to_decimal:N \l_hypo_plot_figwidth_fp }
    \tl_gset:Nx \g_hypo_plot_figheight_dec_tl { \fp_to_decimal:N \l_hypo_plot_figheight_fp }
  }

% Hybrid: xparse for options, VerbatimOut for body
\NewDocumentEnvironment{HypoPyPlot}{ O{} }
  {
    \hypo_plot_pyplot_setup:n {#1}
    % Ensure directories exist before VerbatimOut tries to write
    \hypo_plot_shell_now:n { mkdir~-p~" \tl_use:N \g_hypo_plot_script_dir_tl " }
    \hypo_plot_shell_now:n { mkdir~-p~" \tl_use:N \g_hypo_plot_fig_dir_tl " }
    % Use VerbatimOut to capture body verbatim
    \VerbatimOut{\g_hypo_plot_script_tmp_tex_tl.body}
  }
  {
    \endVerbatimOut
    % Now assemble the full script
    \hypo_plot_assemble_and_execute:
  }

% -----------------------------------------------------------------------------
% Script Assembly Helpers (Refactored for readability)
% -----------------------------------------------------------------------------

% Helper: Write Python script header (imports + color injection)
\cs_new_protected:Npn \hypo_plot_write_header:
  {
    \iow_open:Nn \l_hypo_plot_iow { \g_hypo_plot_script_tmp_tex_tl .header }
    % Standard imports
    \iow_now:Nn \l_hypo_plot_iow { import~matplotlib.pyplot~as~plt }
    \iow_now:Nn \l_hypo_plot_iow { import~numpy~as~np }
    \iow_now:Nn \l_hypo_plot_iow { }
    % Dynamic color injection
    \iow_now:Nx \l_hypo_plot_iow { \c_hash_str \c_hash_str ~---~Dynamic~Color~Injection~--- }
    \iow_now:Nx \l_hypo_plot_iow { HYPO_BLUE~=~" \c_hash_str \tl_use:N \l_hypo_plot_hex_blue_tl " }
    \iow_now:Nx \l_hypo_plot_iow { HYPO_RED~=~" \c_hash_str \tl_use:N \l_hypo_plot_hex_red_tl " }
    \iow_now:Nx \l_hypo_plot_iow { HYPO_GREEN~=~" \c_hash_str \tl_use:N \l_hypo_plot_hex_green_tl " }
    \iow_now:Nx \l_hypo_plot_iow { HYPO_ORANGE~=~" \c_hash_str \tl_use:N \l_hypo_plot_hex_orange_tl " }
    \iow_now:Nx \l_hypo_plot_iow { HYPO_PURPLE~=~" \c_hash_str \tl_use:N \l_hypo_plot_hex_purple_tl " }
    \iow_now:Nn \l_hypo_plot_iow { }
    % Theme fingerprint (for cache invalidation)
    \iow_now:Nx \l_hypo_plot_iow { \c_hash_str \c_hash_str ~---~Theme~fingerprint~--- }
    \iow_now:Nx \l_hypo_plot_iow { \c_hash_str \c_hash_str ~\tl_use:N \g_hypo_plot_theme_fp_tl }
    \iow_now:Nx \l_hypo_plot_iow { \c_hash_str \c_hash_str ~dpi= \int_use:N \l_hypo_plot_dpi_int ,~figwidth= \tl_use:N \g_hypo_plot_figwidth_dec_tl ,~figheight= \tl_use:N \g_hypo_plot_figheight_dec_tl ,~format= \tl_use:N \l_hypo_plot_format_tl }
    \iow_now:Nn \l_hypo_plot_iow { }
    % Figure setup
    \iow_now:Nn \l_hypo_plot_iow { plt.rcParams['font.family']~=~'sans-serif' }
    \iow_now:Nx \l_hypo_plot_iow { plt.figure(figsize=( \tl_use:N \g_hypo_plot_figwidth_dec_tl ,~ \tl_use:N \g_hypo_plot_figheight_dec_tl )) }
    \iow_now:Nn \l_hypo_plot_iow { }
    \iow_close:N \l_hypo_plot_iow
  }

% Helper: Write Python script footer (save figure)
\cs_new_protected:Npn \hypo_plot_write_footer:
  {
    \iow_open:Nn \l_hypo_plot_iow { \g_hypo_plot_script_tmp_tex_tl .footer }
    \iow_now:Nn \l_hypo_plot_iow { }
    \iow_now:Nn \l_hypo_plot_iow { plt.tight_layout() }
    \iow_now:Nx \l_hypo_plot_iow { plt.savefig(r" \tl_use:N \g_hypo_plot_output_shell_path_tl ",~bbox_inches='tight',~dpi= \int_use:N \l_hypo_plot_dpi_int ) }
    \iow_close:N \l_hypo_plot_iow
  }

% Helper: Concatenate header + body + footer into final script
\cs_new_protected:Npn \hypo_plot_concat_script:
  {
    \hypo_plot_shell_now:n
      { cat~" \g_hypo_plot_script_tmp_tl .header"~" \g_hypo_plot_script_tmp_tl .body"~" \g_hypo_plot_script_tmp_tl .footer"~>~" \g_hypo_plot_script_tmp_tl "~&&~rm~-f~" \g_hypo_plot_script_tmp_tl .header"~" \g_hypo_plot_script_tmp_tl .body"~" \g_hypo_plot_script_tmp_tl .footer" }
  }

% Helper: Update script file only if changed (atomic compare-and-swap)
\cs_new_protected:Npn \hypo_plot_update_script_if_changed:
  {
    \hypo_plot_shell_now:n
      { if~cmp~-s~" \tl_use:N \g_hypo_plot_script_tmp_tl "~" \tl_use:N \g_hypo_plot_script_path_tl "~2>/dev/null;~then~rm~-f~" \tl_use:N \g_hypo_plot_script_tmp_tl ";~else~mv~-f~" \tl_use:N \g_hypo_plot_script_tmp_tl "~" \tl_use:N \g_hypo_plot_script_path_tl ";~fi }
  }

% Helper: Run Python script if output is stale
\cs_new_protected:Npn \hypo_plot_run_python_if_needed:
  {
    \hypo_plot_process_if_needed:nnn
      {\g_hypo_plot_script_tex_path_tl}
      {\g_hypo_plot_output_tex_path_tl}
      {
        \exp_args:Nx \hypo_plot_shell_now:n
          { \tl_use:N \g_hypo_plot_python_bin_tl \c_space_tl " \tl_use:N \g_hypo_plot_script_path_tl " }
      }
  }

% Main orchestrator: Assemble and execute Python plot script
\cs_new_protected:Npn \hypo_plot_assemble_and_execute:
  {
    \hypo_plot_write_header:
    \hypo_plot_write_footer:
    \hypo_plot_concat_script:
    \hypo_plot_update_script_if_changed:
    \hypo_plot_run_python_if_needed:
    % Include generated graphics
    \hypo_plot_include_graphics:nn
      {\tl_use:N \g_hypo_plot_include_opts_tl}
      {\g_hypo_plot_output_tex_path_tl}
  }

