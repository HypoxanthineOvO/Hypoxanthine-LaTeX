\tl_new:N \l_hypo_plot_tikz_include_opts_tl
\tl_new:N \l_hypo_plot_tikz_name_tl
\tl_new:N \l_hypo_plot_tikz_src_tl
\tl_new:N \l_hypo_plot_tikz_wrapper_tl
\tl_new:N \l_hypo_plot_tikz_wrapper_tmp_tl
\tl_new:N \l_hypo_plot_tikz_pdf_tl
\tl_new:N \l_hypo_plot_tikz_wrapper_tex_tl
\tl_new:N \l_hypo_plot_tikz_wrapper_tmp_tex_tl
\tl_new:N \l_hypo_plot_tikz_pdf_tex_tl
\tl_new:N \l_hypo_plot_tikz_src_ts_tl
\tl_new:N \l_hypo_plot_tikz_src_copy_tl
\tl_new:N \l_hypo_plot_tikz_src_copy_tmp_tl
\tl_new:N \l_hypo_plot_tikz_src_copy_tex_tl
\tl_new:N \l_hypo_plot_tikz_src_copy_tmp_tex_tl

\keys_define:nn { hypo / plot / tikz }
  {
    width  .tl_set:N = \l_hypo_plot_width_tl,
    width  .initial:n = ,
    height .tl_set:N = \l_hypo_plot_height_tl,
    height .initial:n = ,
    centering .bool_set:N = \l_hypo_plot_centering_bool,
    centering .initial:n = true,
  }

\cs_new_protected:Npn \hypo_plot_write_tikz_wrapper:nnn #1#2#3
  {
    \hypo_plot_collect_theme_fingerprint:N \l_hypo_plot_theme_fp_tl
    \file_get_timestamp:nN {#3} \l_hypo_plot_tikz_src_ts_tl

    \iow_open:Nn \l_hypo_plot_iow {#1}
    \iow_now:Nn \l_hypo_plot_iow {\documentclass[border=2pt]{standalone}}
    \iow_now:Nn \l_hypo_plot_iow {\usepackage{tikz}}
    \iow_now:Nn \l_hypo_plot_iow {\usepackage{Hypo-Colors}}
    \iow_now:Ne \l_hypo_plot_iow
      {\c_percent_str\c_percent_str~HYPO_THEME_FINGERPRINT:~\tl_use:N \l_hypo_plot_theme_fp_tl}
    \iow_now:Ne \l_hypo_plot_iow
      {\c_percent_str\c_percent_str~HYPO_TIKZ_SOURCE:~#3}
    \iow_now:Ne \l_hypo_plot_iow
      {\c_percent_str\c_percent_str~HYPO_TIKZ_TIMESTAMP:~\l_hypo_plot_tikz_src_ts_tl}
    \iow_now:Nn \l_hypo_plot_iow {\begin{document}}
    % Input a local copy stored alongside the wrapper (more robust than
    % relying on assets/ relative paths during external compilation).
    % IMPORTANT: Expand #2 now so the generated wrapper never contains expl3
    % commands like \tl_use:N (standalone compilation won't load expl3).
    \iow_now:Ne \l_hypo_plot_iow {\exp_not:N \input{\tl_use:N \g_hypo_plot_script_dir_tl/#2.tikz}}
    \iow_now:Nn \l_hypo_plot_iow {\end{document}}
    \iow_close:N \l_hypo_plot_iow
  }

\NewDocumentCommand{\HypoTikZFile}{ O{} m m }
  {
    % Reset per-call defaults (avoid state leaking from HypoPyPlot or previous calls)
    \bool_set_true:N \l_hypo_plot_centering_bool
    \keys_set:nn { hypo / plot / tikz } {#1}
    \tl_set:Nn \l_hypo_plot_tikz_name_tl {#2}
    \tl_set:Nn \l_hypo_plot_tikz_src_tl  {#3}

    \hypo_plot_set_include_opts:
    \tl_set_eq:NN \l_hypo_plot_tikz_include_opts_tl \g_hypo_plot_include_opts_tl

    % For TeX writing (\iow_open), use path relative to output dir (implied by -outdir)
    \tl_set:Nn \l_hypo_plot_tikz_wrapper_tex_tl { scripts/\l_hypo_plot_tikz_name_tl.tex }
    \tl_set:Nn \l_hypo_plot_tikz_wrapper_tmp_tex_tl { scripts/\l_hypo_plot_tikz_name_tl.tmp.tex }
    
    % For Shell commands (cp, latexmk), use full path including output dir
    \tl_set:Nx \l_hypo_plot_tikz_wrapper_tl { \tl_use:N \g_hypo_plot_script_dir_tl/\l_hypo_plot_tikz_name_tl.tex }
    \tl_set:Nx \l_hypo_plot_tikz_wrapper_tmp_tl { \tl_use:N \g_hypo_plot_script_dir_tl/\l_hypo_plot_tikz_name_tl.tmp.tex }
    
    % For \includegraphics, use full path (graphics path search is separate from -outdir writing)
    \tl_set:Nx \l_hypo_plot_tikz_pdf_tex_tl { \tl_use:N \g_hypo_plot_fig_dir_tl/\l_hypo_plot_tikz_name_tl.pdf }
    \tl_set:Nx \l_hypo_plot_tikz_pdf_tl { \tl_use:N \g_hypo_plot_fig_dir_tl/\l_hypo_plot_tikz_name_tl.pdf }

    % Also copy the raw TikZ source into the scripts dir (same folder as wrapper)
    \tl_set:Nn \l_hypo_plot_tikz_src_copy_tex_tl { scripts/\l_hypo_plot_tikz_name_tl.tikz }
    \tl_set:Nn \l_hypo_plot_tikz_src_copy_tmp_tex_tl { scripts/\l_hypo_plot_tikz_name_tl.tmp.tikz }
    % Shell paths for cp
    \tl_set:Nx \l_hypo_plot_tikz_src_copy_tl { \tl_use:N \g_hypo_plot_script_dir_tl/\l_hypo_plot_tikz_name_tl.tikz }
    \tl_set:Nx \l_hypo_plot_tikz_src_copy_tmp_tl { \tl_use:N \g_hypo_plot_script_dir_tl/\l_hypo_plot_tikz_name_tl.tmp.tikz }

    \hypo_plot_write_tikz_wrapper:nnn
      {\l_hypo_plot_tikz_wrapper_tmp_tex_tl}
      {\tl_use:N \l_hypo_plot_tikz_name_tl}
      {\tl_use:N \l_hypo_plot_tikz_src_tl}

    % Copy TikZ source (keeps mtime stable via cmp/mv)
    \hypo_plot_shell_now:n
      { cp\space -f\space "\tl_use:N \l_hypo_plot_tikz_src_tl"\space "\tl_use:N \l_hypo_plot_tikz_src_copy_tmp_tl" }
    \hypo_plot_shell_now:n
      { if\space cmp\space -s\space "\tl_use:N \l_hypo_plot_tikz_src_copy_tmp_tl"\space "\tl_use:N \l_hypo_plot_tikz_src_copy_tl"\space 2>/dev/null;\space then\space rm\space -f\space "\tl_use:N \l_hypo_plot_tikz_src_copy_tmp_tl";\space else\space mv\space -f\space "\tl_use:N \l_hypo_plot_tikz_src_copy_tmp_tl"\space "\tl_use:N \l_hypo_plot_tikz_src_copy_tl";\space fi }

    \hypo_plot_shell_now:n
      {
        (\space cmp\space -s\space "\tl_use:N \l_hypo_plot_tikz_wrapper_tmp_tl"\space "\tl_use:N \l_hypo_plot_tikz_wrapper_tl"\space 2>/dev/null\space ||\space mv\space -f\space "\tl_use:N \l_hypo_plot_tikz_wrapper_tmp_tl"\space "\tl_use:N \l_hypo_plot_tikz_wrapper_tl"\space )\space &&\space rm\space -f\space "\tl_use:N \l_hypo_plot_tikz_wrapper_tmp_tl"
      }

    \hypo_plot_process_if_needed:nnn
      {\l_hypo_plot_tikz_wrapper_tex_tl}
      {\l_hypo_plot_tikz_pdf_tex_tl}
      {
        \hypo_plot_shell_now:n
          { latexmk\space -xelatex\space -halt-on-error\space -interaction=batchmode\space -outdir="\tl_use:N \g_hypo_plot_fig_dir_tl"\space -jobname="\tl_use:N \l_hypo_plot_tikz_name_tl"\space "\tl_use:N \l_hypo_plot_tikz_wrapper_tl" }
      }

    \hypo_plot_include_graphics:nn
      {\tl_use:N \l_hypo_plot_tikz_include_opts_tl}
      {\l_hypo_plot_tikz_pdf_tex_tl}
  }

