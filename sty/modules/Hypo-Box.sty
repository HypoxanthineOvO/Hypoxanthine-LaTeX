\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{Hypo-Box}[2026/01/25 v1.1.2 Hypoxanthine Boxes]

% ==============================================================================
% 1. 依赖加载
% ==============================================================================
\RequirePackage{kvoptions}
\RequirePackage{xparse}
\RequirePackage[most]{tcolorbox}
\RequirePackage{Hypo-Colors} % 确保你有这个颜色定义包

% 加载 tcolorbox 定理库
\tcbuselibrary{theorems,breakable,skins}

% ==============================================================================
% 2. 选项处理 (Numbering Logic)
% ==============================================================================
\SetupKeyvalOptions{family=HypoBox, prefix=HypoBox@}

% 编号策略：none | global | section | chapter (默认 section)
\DeclareStringOption[section]{numbering}
\ProcessKeyvalOptions*

\makeatletter

% 定义选项值的常量字符串，方便比较
\def\HypoBox@val@none{none}
\def\HypoBox@val@global{global}
\def\HypoBox@val@section{section}
\def\HypoBox@val@chapter{chapter}

% 计算最终传给 tcolorbox 的参数
% 结果存入 \HypoBox@TheoremOptions
\def\HypoBox@ComputeOptions{%
  \ifx\HypoBox@numbering\HypoBox@val@none
    % 模式: none -> 不编号
    \def\HypoBox@TheoremOptions{no counter}%
  \else\ifx\HypoBox@numbering\HypoBox@val@global
    % 模式: global -> 连续编号 (1, 2, 3...)，不随章节重置
    \def\HypoBox@TheoremOptions{}%
  \else\ifx\HypoBox@numbering\HypoBox@val@chapter
    % 模式: chapter -> 随章重置 (1.1, 1.2...)
    % 如果当前类没有 chapter (如 article)，自动降级为 section
    \@ifundefined{c@chapter}%
      {\def\HypoBox@TheoremOptions{number within=section}}%
      {\def\HypoBox@TheoremOptions{number within=chapter}}%
  \else
    % 模式: section (默认) -> 随节重置
    \def\HypoBox@TheoremOptions{number within=section}%
  \fi\fi\fi
}
% 执行计算
\HypoBox@ComputeOptions
\makeatother

% ==============================================================================
% 3. 样式定义 (Style Definitions)
% ==============================================================================
% 基础样式
\tcbset{
  hypo box/.style={
    enhanced,
    breakable,
    boxrule=0.6pt,
    fonttitle=\bfseries\sffamily,
    coltitle=black,          % 标题文字黑色
    colback=white,           % 内容背景白色
    coltext=HypoText,
    before skip=12pt,
    after skip=12pt,
    left=2mm, right=2mm, top=1mm, bottom=1mm,
    middle=1mm,
    arc=1.2mm,
    separator sign={},       % 不使用默认冒号
  }
}

% 具体的颜色样式
\tcbset{
  % Definition: Primary Color
  hypo definition box/.style={
    hypo box,
    colframe=HypoPrimary,
    colbacktitle=HypoPrimary!15!white,
    title style={left color=HypoPrimary!20!white, right color=white},
  },
  % Example: Success Color
  hypo example box/.style={
    hypo box,
    colframe=HypoSuccess,
    colbacktitle=HypoSuccess!15!white,
    title style={left color=HypoSuccess!20!white, right color=white},
  },
  % Note: Warning Color
  hypo note box/.style={
    hypo box,
    colframe=HypoWarning,
    colbacktitle=HypoWarning!15!white,
    title style={left color=HypoWarning!20!white, right color=white},
  }
}

% ==============================================================================
% 4. 定理环境定义 (Theorem Definitions)
% ==============================================================================
% 使用 \expandafter 展开我们上面计算好的 \HypoBox@TheoremOptions 传入宏中
% 语法: \newtcbtheorem[init options]{env name}{display name}{style}{prefix}

\makeatletter
\expandafter\newtcbtheorem\expandafter[\HypoBox@TheoremOptions]{definition}{Definition}{hypo definition box}{def}

% Math Logic (Share counter with definition if possible, but tcolorbox newtcbtheorem makes its own counter easily.
% For simplicity in this version, let's keep them independent or just standard.)
% To share counters: use counter from=definition
\expandafter\newtcbtheorem\expandafter[\HypoBox@TheoremOptions, use counter from=definition]{theorem}{Theorem}{hypo definition box}{thm}
\expandafter\newtcbtheorem\expandafter[\HypoBox@TheoremOptions, use counter from=definition]{lemma}{Lemma}{hypo definition box}{lem}
\expandafter\newtcbtheorem\expandafter[\HypoBox@TheoremOptions, use counter from=definition]{corollary}{Corollary}{hypo definition box}{cor}
\expandafter\newtcbtheorem\expandafter[\HypoBox@TheoremOptions, use counter from=definition]{proposition}{Proposition}{hypo definition box}{prop}

\expandafter\newtcbtheorem\expandafter[\HypoBox@TheoremOptions]{example}{Example}{hypo example box}{ex}
\expandafter\newtcbtheorem\expandafter[\HypoBox@TheoremOptions]{tip}{Tip}{hypo example box}{tip}

\expandafter\newtcbtheorem\expandafter[\HypoBox@TheoremOptions]{note}{Note}{hypo note box}{note}
\expandafter\newtcbtheorem\expandafter[\HypoBox@TheoremOptions]{important}{Important}{hypo note box}{imp}
\expandafter\newtcbtheorem\expandafter[\HypoBox@TheoremOptions]{warning}{Warning}{hypo note box}{warn}
\makeatother

\endinput